{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    // "strict": true,                           /* Enable all strict type-checking options. */
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es6",
    "jsx": "react",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
    }
  },
  "include": [
    "./src/**/*",
    "./typing/**/*"
  ],
    "exclude": [
    "node_modules"
  ]
}